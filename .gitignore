# Bright Data collector state — contains collection IDs but no tokens.
# You MAY commit this if you want state to persist across machines;
# leave it gitignored if you want a fresh state per clone.
data/.collector_state.json
data/.collector_state.tmp

# Processed outputs (derived from raw — reproducible)
data/processed/

# Figures (reproducible from src/eda.py)
figures/

# Reports (reproducible)
reports/

